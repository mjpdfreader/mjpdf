---
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import Faq from '../components/Faq.astro';
import { SITE, abs } from '../config/site';
import { APK } from '../data/apk';
import { currentRelease } from '../data/releases';
const rows: [string, string][] = [
  ['Version', `${APK.versionName} (version code ${APK.versionCode})`],
  ['Package name', APK.packageName],
  ['File type', 'APK'],
  ['File size', `${APK.sizeLabel} (${APK.sizeBytes.toLocaleString('en-US')} bytes)`],
  ['Requires', `${APK.minAndroid} or newer (targets API ${APK.targetSdk})`],
  ['CPU architecture', 'x86_64 only'],
  ['Signed with', APK.signer],
  ['License', 'GPL-3.0'],
];
const sw = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'MJ PDF', softwareVersion: APK.versionName, operatingSystem: 'Android 6.0+', fileSize: APK.sizeLabel, applicationCategory: 'BusinessApplication', downloadUrl: abs('/download/'), offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
const how = { '@context': 'https://schema.org', '@type': 'HowTo', name: 'Install the MJ PDF 3.1.0 APK', step: ['Download the APK and compare its SHA-256 checksum.', 'Allow installs from your browser or file manager.', 'Open the file and confirm the installation.', 'If Android says the app is incompatible, install from F-Droid or IzzyOnDroid instead.'].map((t, i) => ({ '@type': 'HowToStep', position: i + 1, text: t })) };
---
<Base title="Download MJ PDF 3.1.0 for Android — F-Droid, IzzyOnDroid & APK" description="Download MJ PDF 3.1.0 for Android from F-Droid or IzzyOnDroid, get the source code, or download the x86_64 APK with size and SHA-256 checksum." path="/download/" crumbs={[{name:'Download',path:'/download/'}]} jsonld={[sw, how]} keywords="download MJ PDF, MJ PDF APK, MJ PDF F-Droid, MJ PDF 3.1.0">
  <div class="wrap page-h"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Download</nav>
    <h1>Download <span class="grad">MJ PDF {currentRelease.version}</span></h1>
    <p class="lead" style="margin-top:1rem">Free and open source. Choose the channel that fits your device.</p></div>
  <section class="sec" style="padding-top:30px"><div class="wrap">
    <div class="note"><strong>Check your CPU first.</strong> {APK.abiNote}</div>
    <div class="grid2">
      <div class="card glow"><span class="eyebrow">Recommended for phones</span><h2 style="font-size:1.7rem">Official channels</h2>
        <p>These channels deliver the build that matches your device and handle updates for you.</p>
        <div class="btn-row"><a class="btn pri" href={SITE.links.fdroid} rel="noopener">Get it on F-Droid</a><a class="btn pri" href={SITE.links.izzy} rel="noopener">IzzyOnDroid</a><a class="btn" href={SITE.links.source} rel="noopener">View source code</a></div></div>
      <div class="card"><span class="eyebrow">Direct download</span><h2 style="font-size:1.7rem">APK for x86_64</h2>
        <p>For emulators, Chromebooks and x86 tablets. Served unmodified.</p>
        <div class="btn-row"><a class="btn pri" href={APK.path} download={APK.fileName}>Download MJ PDF {currentRelease.version} APK</a></div></div>
    </div>
    <h2 style="margin-top:clamp(40px,6vw,80px)">APK details</h2>
    <div class="card"><table class="spec"><tbody>
      {rows.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
      <tr><th scope="row">SHA-256</th><td class="mono">{APK.sha256}</td></tr>
    </tbody></table></div>
    <div class="split"><div class="txt"><h2>Install the APK</h2>
      <ol class="steps"><li><div><b>Download and verify</b><span>Compare the file's SHA-256 with the checksum above.</span></div></li><li><div><b>Allow the install</b><span>Android asks you to allow installs from your browser or file manager.</span></div></li><li><div><b>Open the file</b><span>Tap the downloaded APK and confirm.</span></div></li><li><div><b>Not compatible?</b><span>Your device is ARM-based. Use F-Droid or IzzyOnDroid.</span></div></li></ol></div>
      <Phone id="home" /></div>
    <h2>Trust &amp; security</h2>
    <p class="lead">The APK is served unmodified from this website. Its package name, <code>{APK.packageName}</code>, matches the F-Droid and IzzyOnDroid listings. It is signed with an F-Droid build key rather than a developer release key, so it will not update over a build signed with a different key. Read the <a href="/privacy/">privacy and permissions page</a> before installing.</p>
    <h2 style="margin-top:clamp(40px,6vw,80px)">Installation questions</h2>
    <Faq group="Installing" />
  </div></section>
</Base>
