---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { faqs } from '../data/faq';
const groups = [...new Set(faqs.map((f) => f.group))];
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title="MJ PDF FAQ — Installing, Features and Privacy" description="Answers to common questions about MJ PDF 3.1.0: Android support, installing from F-Droid, the x86_64 APK, dark mode, highlights, Text Mode and privacy." path="/faq/" crumbs={[{name:'FAQ',path:'/faq/'}]} jsonld={[ld]}>
  <div class="wrap page-h"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / FAQ</nav>
    <h1>Frequently asked <span class="grad">questions</span></h1></div>
  <section class="sec" style="padding-top:20px"><div class="wrap narrow">
    {groups.map((g) => <div style="margin-bottom:2.4rem"><h2 style="font-size:1.5rem">{g}</h2>{faqs.filter((f) => f.group === g).map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>)}
  </div></section>
  <Cta />
</Base>
