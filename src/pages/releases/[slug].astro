---
import Base from '../../layouts/Base.astro';
import Phone from '../../components/Phone.astro';
import Cta from '../../components/Cta.astro';
import { SITE, abs } from '../../config/site';
import { releases } from '../../data/releases';
export function getStaticPaths() {
  return releases.filter((r) => r.highlights.length || r.current).map((release) => ({ params: { slug: release.slug }, props: { release } }));
}
const { release } = Astro.props;
const prev = releases[releases.findIndex((r) => r.slug === release.slug) + 1];
const art = { '@context': 'https://schema.org', '@type': 'TechArticle', headline: `${release.title} — Release Notes`, description: release.summary, mainEntityOfPage: abs(`/releases/${release.slug}/`), image: abs('/images/og-mj-pdf-3-1-0.png'), author: { '@type': 'Person', name: SITE.author }, ...(release.date ? { datePublished: release.date } : {}) };
---
<Base title={`${release.title} — Release Notes`} description={`${release.summary} Includes ${release.highlights.slice(0,3).join(', ').toLowerCase()} and more.`} path={`/releases/${release.slug}/`} crumbs={[{name:'Releases',path:'/releases/'},{name:release.version,path:`/releases/${release.slug}/`}]} ogType="article" jsonld={[art]}>
  <div class="wrap page-h"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/releases/">Releases</a> / {release.version}</nav>
    <h1>{release.title} <span class="grad">release notes</span></h1>
    <p class="lead" style="margin-top:1rem">{release.summary}</p>
    {release.date && <p>Released {release.date}</p>}</div>
  <section class="sec" style="padding-top:20px"><div class="wrap">
    <div class="split"><div class="txt prose">
      <h2>What's new and improved</h2>
      <ul class="checks">{release.highlights.map((h) => <li>{h}</li>)}</ul>
      <h2>Fixes across</h2>
      <ul class="checks">{release.fixes.map((h) => <li>{h}</li>)}</ul>
      <p style="margin-top:1.4rem">This summary follows the project's published release information. For the complete changelog see the <a href={SITE.links.source} rel="noopener">official repository</a>.</p>
      <div class="btn-row"><a class="btn pri" href="/download/">Download</a><a class="btn" href={SITE.links.source} rel="noopener">Source Code</a>{prev && prev.highlights.length > 0 && <a class="btn" href={`/releases/${prev.slug}/`}>Previous: {prev.version}</a>}</div>
    </div><Phone id="menu" /></div>
    <h2>Why 3.1.0 matters</h2>
    <div class="grid3">
      <div class="card"><h3>Reading</h3><p>Single Page mode, page fit options and unified Reading Mode settings give you more control over how pages are shown, and improved theme controls make the look of the reader easier to adjust.</p></div>
      <div class="card"><h3>Finding things</h3><p>In-document search is improved, and document identification is improved.</p></div>
      <div class="card"><h3>Trust</h3><p>Files are saved more safely, and rescue copies are made after a failed save.</p></div>
    </div>
  </div></section>
  <Cta />
</Base>
