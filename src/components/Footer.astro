---
import { SITE } from '../config/site';
import { currentRelease } from '../data/releases';
import { guides } from '../data/guides';
---
<footer><div class="wrap">
  <div class="cols">
    <div>
      <a class="brand" href="/"><img src="/images/mj-pdf-icon-48.png" width="36" height="36" alt="" />MJ PDF {currentRelease.version}</a>
      <p style="margin-top:1rem">MJ PDF is a free, open-source Android PDF reader made by {SITE.author} (GPL-3.0). This website is an independent presentation of the app. The project's own page is at <a href={SITE.links.official} rel="noopener">mudlej.com/projects/mj-pdf</a>.</p>
    </div>
    <div><h4>Explore</h4><ul><li><a href="/features/">Features</a></li><li><a href="/screenshots/">Screenshots</a></li><li><a href="/download/">Download</a></li><li><a href="/releases/">Releases</a></li><li><a href="/releases/3-1-0/">3.1.0 release notes</a></li></ul></div>
    <div><h4>Guides</h4><ul>{guides.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title.replace(/^How to /, '')}</a></li>)}</ul></div>
    <div><h4>Project</h4><ul><li><a href={SITE.links.source} rel="noopener">Source code</a></li><li><a href={SITE.links.mirror} rel="noopener">GitHub mirror</a></li><li><a href={SITE.links.fdroid} rel="noopener">F-Droid</a></li><li><a href={SITE.links.izzy} rel="noopener">IzzyOnDroid</a></li><li><a href="/faq/">FAQ</a></li><li><a href="/privacy/">Privacy</a></li><li><a href="/about/">About</a></li><li><a href="/sitemap/">Sitemap</a></li><li><a href="/rss.xml">RSS feed</a></li></ul></div>
  </div>
  <p class="fine">Book covers visible in screenshots belong to their respective publishers and appear only as sample content. Android is a trademark of Google LLC.</p>
</div></footer>
