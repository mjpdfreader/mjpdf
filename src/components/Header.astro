---
interface Props { current: string }
const { current } = Astro.props;
const items = [['Features','/features/'],['Screenshots','/screenshots/'],['Releases','/releases/'],['FAQ','/faq/'],['Privacy','/privacy/'],['About','/about/']];
---
<header class="top"><div class="wrap">
  <a class="brand" href="/"><img src="/images/mj-pdf-icon-48.png" width="36" height="36" alt="" />MJ PDF</a>
  <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">Menu</button>
  <nav id="site-nav" aria-label="Main"><ul>
    {items.map(([n,h]) => <li><a href={h} aria-current={current.startsWith(h) ? 'page' : undefined}>{n}</a></li>)}
    <li><a class="btn pri" href="/download/" style="padding:8px 18px;color:#fff">Download</a></li>
  </ul></nav>
</div></header>
