---
import { shots, shotSrc, SHOT_W, SHOT_H, type Shot } from '../data/screenshots';
interface Props { items?: Shot[] }
const { items = shots } = Astro.props;
---
<div class="gallery" role="list">
  {items.map((s, i) => (
    <figure role="listitem">
      <button type="button" data-i={i} aria-label={`Enlarge: ${s.title}`}>
        <img src={shotSrc(s, 400)} srcset={`${shotSrc(s,400)} 400w, ${shotSrc(s,800)} 800w`} sizes="260px" width={SHOT_W} height={SHOT_H} loading="lazy" alt={s.alt} />
      </button>
      <figcaption><b>{s.title}</b>{s.caption}</figcaption>
    </figure>
  ))}
</div>
<dialog class="lb" aria-label="Screenshot viewer">
  <div class="lb-in">
    <img alt="" width={SHOT_W} height={SHOT_H} />
    <p class="lb-cap"></p>
    <div class="lb-bar"><button data-a="prev">Previous</button><button data-a="next">Next</button><button data-a="close">Close</button></div>
  </div>
</dialog>
<script is:inline define:vars={{ data: items.map((s) => ({ src: shotSrc(s, 800), alt: s.alt, cap: `${s.title}. ${s.caption}` })) }}>
(function(){
  var d=document.currentScript.previousElementSibling,img=d.querySelector('img'),cap=d.querySelector('.lb-cap'),i=0;
  function show(n){i=(n+data.length)%data.length;img.src=data[i].src;img.alt=data[i].alt;cap.textContent=data[i].cap}
  document.querySelectorAll('.gallery button[data-i]').forEach(function(b){b.addEventListener('click',function(){show(+b.dataset.i);d.showModal()})});
  d.addEventListener('click',function(e){var a=e.target.dataset&&e.target.dataset.a;if(a==='prev')show(i-1);else if(a==='next')show(i+1);else if(a==='close'||e.target===d)d.close()});
  d.addEventListener('keydown',function(e){if(e.key==='ArrowLeft')show(i-1);if(e.key==='ArrowRight')show(i+1)});
})();
</script>
